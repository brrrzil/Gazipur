    - target: {fileID: 2772581546650856096, guid: 6522f1213dc9dc9458bb51fbe02b8cb6, type: 3}
      propertyPath: _remarks.Array.data[22].remark
      value: "\u041E\u043E\u043E! \u041E\u0442\u0441\u044E\u0434\u0430 \u0432\u0441\u0435
        \u0441\u0431\u0435\u0436\u0430\u043B\u0438, \u043A\u043E\u0433\u0434\u0430
        \u0441\u0432\u0430\u043B\u043A\u0430 \u043D\u0430\u0447\u0430\u043B\u0430
        \u043D\u0430\u0441\u0442\u0443\u043F\u0430\u0442\u044C.\n\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C,
        \u0447\u0442\u043E \u043E\u043D\u0438 \u043F\u043E\u0431\u0440\u043E\u0441\u0430\u043B\u0438..."
      objectReference: {fileID: 0}
