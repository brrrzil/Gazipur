    - target: {fileID: 2772581546650856096, guid: 6522f1213dc9dc9458bb51fbe02b8cb6, type: 3}
      propertyPath: _remarks.Array.data[2].remark
      value: "\u0418\u0448\u0430 \u043A\u0440\u0443\u0448\u0438\u0442\u044C! \u041D\u0435\u0442,
        \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u043E, \u044F \u043D\u0435 \u0441\u043F\u0440\u0430\u0432\u043B\u044E\u0441\u044C
        \u0433\u043E\u043B\u044B\u043C\u0438 \u0440\u0443\u043A\u0430\u043C\u0438."
      objectReference: {fileID: 0}
    - target: {fileID: 2772581546650856096, guid: 6522f1213dc9dc9458bb51fbe02b8cb6, type: 3}
      propertyPath: _remarks.Array.data[3].remark
      value: "\u0410\u0439! \u041D\u0435\u043F\u0440\u0438\u044F\u0442\u043D\u043E,
        \u043A\u043E\u0433\u0434\u0430 \u043E\u0442\u0432\u0435\u0440\u0442\u043A\u0430
        \u0441\u043E\u0441\u043A\u0430\u043A\u0438\u0432\u0430\u0435\u0442 \u0438
        \u043F\u0440\u043E\u0442\u044B\u043A\u0430\u0435\u0442 \u0440\u0443\u043A\u0443!"
      objectReference: {fileID: 0}
    - target: {fileID: 2772581546650856096, guid: 6522f1213dc9dc9458bb51fbe02b8cb6, type: 3}
      propertyPath: _remarks.Array.data[4].chance
      value: 100
      objectReference: {fileID: 0}
    - target: {fileID: 2772581546650856096, guid: 6522f1213dc9dc9458bb51fbe02b8cb6, type: 3}
      propertyPath: _remarks.Array.data[4].remark
      value: "\u041E! \u0415\u0441\u043B\u0438 \u043F\u0435\u0440\u0435\u043A\u0443\u0441\u0438\u0442\u044C
        \u0437\u0434\u0435\u0441\u044C \u0438 \u0437\u0434\u0435\u0441\u044C, \u043E\u043D\u0430
        \u043E\u0442\u0432\u0430\u043B\u0438\u0442\u0441\u044F! \u041C\u043E\u0436\u0435\u0442,
        \u0443 \u0420\u0430\u0445\u0443\u043B\u0430 \u043D\u0430\u0439\u0434\u0451\u0442\u0441\u044F
        \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442?"
      objectReference: {fileID: 0}
