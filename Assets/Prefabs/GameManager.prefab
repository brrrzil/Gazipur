      value: "\u0420\u0430\u0445\u0443\u043B \u0432\u0441\u0435\u0433\u0434\u0430
        \u043F\u043E\u043C\u043E\u0436\u0435\u0442!"
      objectReference: {fileID: 0}
    - target: {fileID: 2772581546650856096, guid: 6522f1213dc9dc9458bb51fbe02b8cb6, type: 3}
      propertyPath: _remarks.Array.data[20].chance
      value: 100
      objectReference: {fileID: 0}
    - target: {fileID: 2772581546650856096, guid: 6522f1213dc9dc9458bb51fbe02b8cb6, type: 3}
      propertyPath: _remarks.Array.data[20].remark
      value: "\u0427\u0443\u0448\u044C \u043A\u0430\u043A\u0430\u044F-\u0442\u043E.
        \u041D\u0430\u0434\u043E \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C
        \u0441 \u043C\u0430\u043C\u043E\u0439."
      objectReference: {fileID: 0}
    - target: {fileID: 2772581546650856096, guid: 6522f1213dc9dc9458bb51fbe02b8cb6, type: 3}
      propertyPath: _remarks.Array.data[21].chance
      value: 100
      objectReference: {fileID: 0}
    - target: {fileID: 2772581546650856096, guid: 6522f1213dc9dc9458bb51fbe02b8cb6, type: 3}
      propertyPath: _remarks.Array.data[21].remark
      value: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u044F \u0434\u043E\u043B\u0436\u043D\u0430
        \u0434\u043E\u0441\u0442\u0430\u0442\u044C \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u043E
        \u0434\u043B\u044F \u043C\u0430\u043C\u044B. \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435
        \u043F\u043E\u0434\u043E\u0436\u0434\u0451\u0442."
      objectReference: {fileID: 0}
    - target: {fileID: 2772581546650856096, guid: 6522f1213dc9dc9458bb51fbe02b8cb6, type: 3}
      propertyPath: _remarks.Array.data[22].chance
      value: 100
