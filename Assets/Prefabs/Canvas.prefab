    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\"\u0421 \u044D\u0442\u043E\u0439 \u0441\u0435\u0442\u043A\u043E\u0439
    \u0442\u044B \u043C\u0443\u0440\u0430\u0432\u0435\u0439, \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u044E\u0449\u0438\u0439
    \u0433\u0440\u043E\u043C\u0430\u0434\u043D\u0443\u044E \u0442\u044F\u0436\u0435\u0441\u0442\u044C.
    \u0422\u044B \u0443\u043B\u0438\u0442\u043A\u0430, \u043D\u0435\u0441\u0443\u0449\u0430\u044F
    \u0446\u0435\u043B\u044B\u0439 \u0434\u043E\u043C!.. \n...\u043D\u0435\u0442,
    \u043E\u043D\u0430 \u043F\u0440\u0430\u0432\u0434\u0430 \u043E\u0447\u0435\u043D\u044C
    \u0432\u043C\u0435\u0441\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F.\""
